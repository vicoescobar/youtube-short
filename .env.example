# Obtenez une clé gratuitement sur https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optionnel / Recommandé pour transcription audio ultra-rapide si pas de sous-titres YouTube)
